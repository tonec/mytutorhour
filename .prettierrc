{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "importOrder": [
    "next/(.*)$",
    "@lib/(.*)$",
    "@services/(.*)$",
    "@hooks/(.*)$",
    "@heroui/(.*)$",
    "@components/(.*)$",
    "^[../]",
    "^[./]"
  ],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "importOrderSideEffects": false
}
